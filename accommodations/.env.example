# Production pooled Postgres URL; use a dedicated database. Never use production in previews.
DATABASE_URL=
# Separate migration role with DDL privileges; falls back to DATABASE_URL locally.
MIGRATION_DATABASE_URL=
BRAVE_SEARCH_API_KEY=
# Set true only after confirming your subscribed plan permits persistent result storage.
BRAVE_STORAGE_RIGHTS_CONFIRMED=false
# Separate strong passphrases, minimum 16 characters. Do not put them in URLs.
FAMILY_PASSWORD=
ADMIN_PASSWORD=
SESSION_SECRET=
CRON_SECRET=
# Explicit operator switch after migration, seed and successful real scan.
SCANS_ENABLED=false

# Canonical deployed origin for CSRF checks (no trailing slash).
APP_ORIGIN=
